# Neon pooled PostgreSQL connection string; server only. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_POOLER_HOST/neondb?sslmode=require
# Clerk instance URL (iss in session tokens), e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER_URL=
# Must match the actual browser origin. Comma-separated if needed.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional: require a configured JWT audience as well.
CLERK_AUDIENCE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTHORIZED_SIGNATORY=SamkovAI Program Office
# disabled, local (persistent disk), or s3 (private S3-compatible bucket)
FILE_STORAGE=disabled
UPLOAD_DIR=backend/uploads
# Generate a random 32+ character value for local signed download links.
FILE_SIGNING_SECRET=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
