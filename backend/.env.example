DATABASE_URL=
CLERK_ISSUER_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTHORIZED_SIGNATORY=SamkovAI Program Office
# Gmail SMTP: use an app password, never your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Set EMAIL_USE_SSL=true when using implicit TLS (usually port 465).
EMAIL_USE_SSL=false
EMAIL_USERNAME=samkovaicorporation@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=samkovaicorporation@gmail.com
# Brevo HTTPS API key; when set, this is used instead of SMTP.
BREVO_API_KEY=
FILE_STORAGE=disabled
# Optional local uploads: set FILE_STORAGE=local and a random secret of 32+ characters.
UPLOAD_DIR=backend/uploads
FILE_SIGNING_SECRET=

# Server-only Clerk key for syncing the account directory.
CLERK_SECRET_KEY=
